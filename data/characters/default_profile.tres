[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://src/Defs/PlayerProfile.cs" id="1_profile"]
[ext_resource type="Script" path="res://src/Defs/StatBlock.cs" id="2_stats"]
[ext_resource type="Resource" path="res://data/characters/soldier_visual.tres" id="3_visual"]
[ext_resource type="Script" path="res://src/Defs/ActiveAbilityDef.cs" id="4_ability"]
[ext_resource type="Resource" path="res://data/abilities/arrow.tres" id="5_arrow"]
[ext_resource type="Resource" path="res://data/abilities/dash.tres" id="6_dash"]
[ext_resource type="Script" path="res://src/Defs/AbilityDef.cs" id="9_catalog"]
[ext_resource type="Resource" path="res://data/abilities/prospector.tres" id="10_prospector"]
[ext_resource type="Resource" path="res://data/abilities/swift_boots.tres" id="11_swift_boots"]
[ext_resource type="Resource" path="res://data/abilities/vitality.tres" id="12_vitality"]
[ext_resource type="Resource" path="res://data/abilities/might.tres" id="13_might"]
[ext_resource type="Resource" path="res://data/abilities/volley.tres" id="14_volley"]
[ext_resource type="Resource" path="res://data/abilities/blade_sweep.tres" id="15_blade_sweep"]
[ext_resource type="Resource" path="res://data/abilities/bounty.tres" id="16_bounty"]

[sub_resource type="Resource" id="Resource_stats"]
script = ExtResource("2_stats")
MaxHealth = 100.0
MoveSpeed = 140.0
Attack = 1.0

[resource]
script = ExtResource("1_profile")
Stats = SubResource("Resource_stats")
Visual = ExtResource("3_visual")
SlotCount = 6
InnateAbilities = Array[ExtResource("4_ability")]([ExtResource("5_arrow"), ExtResource("6_dash")])
Abilities = Array[ExtResource("9_catalog")]([ExtResource("10_prospector"), ExtResource("11_swift_boots"), ExtResource("12_vitality"), ExtResource("13_might"), ExtResource("14_volley"), ExtResource("15_blade_sweep"), ExtResource("16_bounty")])
